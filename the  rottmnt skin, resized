:root {
  --text: #FFFFFF;
  --none: #999999;
  --g: #78A700;
  --t: #E6B000;
  --m: #D76D12;
  --e: #B0021F;
  --ff: #B0021F;
  --fm: #910679;
  --gen: #78A700;
  --mm: #0054D4;
  --other: #000000;
