  --warn: #B0021F;
  --ext: #107CB9;
  --wip: #B0021F;
  --fin: #78A700;
}

.blurb .header:has(ul.required-tags) .heading {
  margin-left: 0;
}

.blurb ul.required-tags,
.blurb ul.required-tags li,
.blurb ul.required-tags li a,
.blurb ul.required-tags li span,
.blurb ul.required-tags li + li + li,
.blurb ul.required-tags li + li + li + li {
  display: block;
  position: unset;
  width: unset;
  height: unset;
  margin: unset;
  padding: unset;
  border: unset;
  background: unset;
  font-size: 1em;
  font-weight: initial;
  text-transform: capitalize;
  line-height: 1;
  color: var(--text);
}

.blurb ul.required-tags {
  display: flex;
  flex-wrap: wrap;
  column-gap: 0.3em;
  margin-top: 0.35em;
  margin-bottom: 0;
}

.blurb ul.required-tags > li > a > span.warnings,
.blurb ul.required-tags > li > a > span:not(:is(.warning-yes,
.warning-choosenotto))::before {
  display: block;
  margin-block: 0.15em;
  padding-block: 0.25em;
  padding-inline: 0.35em;
  border-radius: 0;
}

.blurb ul.required-tags > li > a > span:not(.warnings) > span.text {
  display: none;
}

.index:not(.prompt) .blurb ul.required-tags > li:has(.warnings):not(:has(.warning-yes,
.warning-choosenotto)),
.index:not(.prompt) .blurb ul.required-tags > li > a > :is(.warning-yes,
.warning-choosenotto) > span.text {
  display: none;
}

.required-tags .warning-choosenotto {
  background: var(--cntw) !important;
}

.index:not(.prompt) .required-tags .warning-choosenotto::before {
  content: "CNTW";
}

.required-tags .warning-yes {
  background: var(--warn) !important;
}

.index:not(.prompt) .required-tags .warning-yes::before {
